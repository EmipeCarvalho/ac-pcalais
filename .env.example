GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Use free somente com um projeto confirmado como Nível gratuito no AI Studio.
GEMINI_PRICING_TIER=free
# Preencha as tarifas vigentes do modelo em USD por milhão de tokens.
# Sem tarifas, o custo fica desconhecido (nunca é registrado como zero).
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
DB_PATH=data/menu_atlas.sqlite
# Limite configurável por moeda/unidade do conjunto usado.
MAX_REASONABLE_PRICE=1000
